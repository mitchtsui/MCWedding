{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "git": { "deploymentEnabled": false },
  "functions": {
    "api/vip-assets.js": { "includeFiles": "{hub-private/vip-data.json,photos/vip/**}" },
    "api/captions-stream.js": { "maxDuration": 300 },
    "api/captions.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/", "destination": "/wedding-invitation.html" }
  ]
}
