# Local / Vercel configuration template. NEVER commit a populated .env file.
# Keep captions disabled until migration, permissions audit and compatibility checks pass.
CAPTIONS_ENABLED=false
# Set to true to let guests read captions from a QR-code link, without a Supabase account.
CAPTIONS_GUEST_LINKS=
# Server only. Standard base64 of a PKCS#8 DER ECDSA P-256 private key that signs guest captions.
CAPTIONS_GUEST_SIGNING_KEY=
CAPTIONS_ALLOWED_ORIGINS=https://your-approved-preview.vercel.app

# Existing MCWedding public connection settings, exposed by /api/config.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-publishable-or-anon-key

# Server only. Never expose through /api/config.js, browser bundles or logs.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-key
OPENAI_API_KEY=your-project-specific-openai-key
OPENAI_ASR_MODEL=gpt-live-transcribe
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_ASR_DELAY=low

# Engineering starting points; validate against actual speech and deployment limits.
CAPTIONS_COMMIT_MODE=pause
CAPTIONS_PAUSE_MS=450
CAPTIONS_MAX_TURN_MS=6000
CAPTIONS_FIXED_COMMIT_MS=4000
CAPTIONS_VAD_RMS_THRESHOLD=0.012
CAPTIONS_ROTATE_AFTER_MS=240000
CAPTIONS_MAX_SESSION_MS=285000
# Optional short vocabulary/context hint; scripts are separately reviewed by an operator.
CAPTIONS_ASR_PROMPT=
